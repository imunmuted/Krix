# Server Port Configuration (defaults to 3000 if omitted)
PORT=3000

# REQUIRED. Secure access key for the Krix gateway (the server refuses to start without it).
# Generate one with: openssl rand -hex 32
# Clients pass it via the x-api-key header or "Authorization: Bearer <key>".
MCP_API_KEY=your_mcp_gateway_security_key_here

# Public https URL of this server. Used to build file download links. STRONGLY recommended behind a proxy.
# PUBLIC_BASE_URL=https://krix.example.com

# GitHub Access Token (fallback if x-github-token header is omitted by client)
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_your_github_token_here
# Alternative alias for GitHub token:
# GITHUB_PAT=ghp_your_github_token_here

# Render API Key (fallback if x-render-token header is omitted by client)
RENDER_API_KEY=rnd_your_render_api_key_here
# Alternative alias for Render token:
# RENDER_PAT=rnd_your_render_api_key_here

# ---------------------------------------------------------------------------
# Files (sandbox_files: share / list / delete / download) — MongoDB
# ---------------------------------------------------------------------------
# MongoDB connection string. MongoDB Atlas example:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Use a dedicated database user with readWrite on the database below ONLY, and restrict Atlas network access.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
# Database name used for the GridFS bucket "krix_files" (default: krix)
MONGODB_DB=krix
# Set to 'false' to turn the file-sharing tools off entirely (default: enabled)
ENABLE_FILE_SHARING=true
# Hours until a shared file is auto-deleted. 1-48, default 48 (48 is also the maximum).
FILE_TTL_HOURS=48
# Quotas (defaults shown)
FILE_MAX_MB=25
FILE_MAX_PER_OWNER=50
FILE_MAX_TOTAL_MB_PER_OWNER=200

# sandbox_files action:download — max download size in MB (default 50) and whether private/internal
# addresses may be fetched (default false; leave off unless you need to reach your own LAN services).
DOWNLOAD_MAX_MB=50
# ALLOW_PRIVATE_DOWNLOADS=false

# ---------------------------------------------------------------------------
# Tool categories
# ---------------------------------------------------------------------------
# Enable All Tools by default (Optional: set to 'true' to bypass lazy-loading)
ENABLE_ALL_TOOLS=false

# Category-specific Tool Flags (Disabled by default, set to 'true' to enable)
ENABLE_GITHUB_ISSUES_PRS=false
ENABLE_GITHUB_ADMIN=false
ENABLE_RENDER=false

# Sandbox & Local Git Tools Flag (Enabled by default, set to 'false' to disable)
ENABLE_SANDBOX=true

# ---------------------------------------------------------------------------
# Sandbox isolation (the provided Dockerfile sets these for you)
# ---------------------------------------------------------------------------
# Run sandboxed code as this unprivileged user. Requires the server to run as root (in a container).
# SANDBOX_UID=10001
# SANDBOX_GID=10001
# When true (default in NODE_ENV=production) the sandbox refuses to run without the isolation above.
# SANDBOX_REQUIRE_ISOLATION=true

# Best-effort guardrail levels: low | medium | high (default: low). NOT a security boundary.
COMMAND_RESTRICTION_LEVEL=low
NETWORK_RESTRICTION_LEVEL=low

# ---------------------------------------------------------------------------
# HTTP hardening
# ---------------------------------------------------------------------------
# Number of reverse-proxy hops in front of the server (used for client IPs / rate limiting). Default 1.
# TRUST_PROXY=1
# Allow ?api_key=... in the URL (default true for compatibility). Set false once your client uses headers.
# ALLOW_QUERY_API_KEY=false
# Comma-separated browser Origins allowed to call /mcp (unset = no Origin restriction).
# ALLOWED_ORIGINS=https://claude.ai
# MAX_SESSIONS=50
# MAX_BODY_MB=16
# RATE_LIMIT_PER_MIN=600

# Auth Context Persistence TTL in ms (default: 3600000 / 1h)
AUTH_CONTEXT_TTL_MS=3600000
